{
  "name": "Healthy Chronos - Aviso de dosis omitida",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dosis-omitida",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "9a1f3c2e-1b7d-4c55-8f0e-0a1b2c3d4e01",
      "name": "Webhook dosis omitida",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "5f0c6a8e-2d4b-4b1e-9c3a-7e6d5c4b3a21"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1a2b3c4-0001-4000-8000-000000000001",
              "leftValue": "={{ $json.body.evento }}",
              "rightValue": "DOSIS_OMITIDA",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c1a2b3c4-0002-4000-8000-000000000002",
              "leftValue": "={{ $json.body.paciente.correo }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9a1f3c2e-1b7d-4c55-8f0e-0a1b2c3d4e02",
      "name": "¿Datos válidos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "Healthy Chronos <TU_CORREO@gmail.com>",
        "toEmail": "={{ $json.body.paciente.correo }}",
        "subject": "={{ $json.body.esPrueba ? '[PRUEBA] ' : '' }}Dosis sin confirmar: {{ $json.body.medicamento.nombre }} de las {{ $json.body.medicamento.horaProgramada }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#111813\">\n  <div style=\"background:#0E1711;color:#ffffff;padding:20px 24px;border-radius:12px 12px 0 0\">\n    <div style=\"font-size:13px;letter-spacing:1px;color:#8FD694;font-weight:bold\">HEALTHY CHRONOS</div>\n    <div style=\"font-size:22px;font-weight:bold;margin-top:4px\">Dosis sin confirmar</div>\n  </div>\n  <div style=\"border:1px solid #D7E5D9;border-top:0;padding:20px 24px;border-radius:0 0 12px 12px\">\n    <p style=\"font-size:16px;margin:0 0 16px\">Hola {{ $json.body.paciente.nombre || 'paciente' }}, la dosis de <b>{{ $json.body.medicamento.nombre }}</b> programada a las <b>{{ $json.body.medicamento.horaProgramada }}</b> no se ha marcado como tomada después de {{ $json.body.minutosSinConfirmar }} minutos.</p>\n    <table style=\"width:100%;border-collapse:collapse;font-size:15px\">\n      <tr><td style=\"padding:8px;border-bottom:1px solid #D7E5D9;color:#56655A\">Medicamento</td><td style=\"padding:8px;border-bottom:1px solid #D7E5D9\"><b>{{ $json.body.medicamento.nombre }}</b></td></tr>\n      <tr><td style=\"padding:8px;border-bottom:1px solid #D7E5D9;color:#56655A\">Dosis</td><td style=\"padding:8px;border-bottom:1px solid #D7E5D9\">{{ $json.body.medicamento.dosis }}</td></tr>\n      <tr><td style=\"padding:8px;border-bottom:1px solid #D7E5D9;color:#56655A\">Hora programada</td><td style=\"padding:8px;border-bottom:1px solid #D7E5D9\">{{ $json.body.medicamento.horaProgramada }}</td></tr>\n      <tr><td style=\"padding:8px;border-bottom:1px solid #D7E5D9;color:#56655A\">Contacto de emergencia</td><td style=\"padding:8px;border-bottom:1px solid #D7E5D9\">{{ $json.body.contactoEmergencia.nombre || 'No registrado' }} {{ $json.body.contactoEmergencia.telefono ? '· ' + $json.body.contactoEmergencia.telefono : '' }}</td></tr>\n    </table>\n    <p style=\"font-size:15px;margin:16px 0 0\">Si ya tomó el medicamento, márquelo como tomado en la app para mantener el historial al día. Si tiene dudas sobre la dosis, consulte a su médico.</p>\n    <p style=\"font-size:12px;color:#56655A;margin:20px 0 0\">Aviso automático de Healthy Chronos · {{ $json.body.fechaHora ? DateTime.fromISO($json.body.fechaHora).setZone('America/Bogota').setLocale('es').toFormat(\"d 'de' LLLL 'de' yyyy, h:mm a\") : $now.setZone('America/Bogota').setLocale('es').toFormat(\"d 'de' LLLL 'de' yyyy, h:mm a\") }}</p>\n  </div>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "9a1f3c2e-1b7d-4c55-8f0e-0a1b2c3d4e03",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        500,
        200
      ],
      "credentials": {
        "smtp": {
          "id": "hcSmtpCredencial1",
          "name": "SMTP Healthy Chronos"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, enviadoA: $('Webhook dosis omitida').item.json.body.paciente.correo, medicamento: $('Webhook dosis omitida').item.json.body.medicamento.nombre } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "9a1f3c2e-1b7d-4c55-8f0e-0a1b2c3d4e04",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        760,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"ok\": false,\n  \"error\": \"Datos incompletos: se requiere evento DOSIS_OMITIDA y paciente.correo\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "9a1f3c2e-1b7d-4c55-8f0e-0a1b2c3d4e05",
      "name": "Responder error 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        500,
        420
      ]
    }
  ],
  "connections": {
    "Webhook dosis omitida": {
      "main": [
        [
          {
            "node": "¿Datos válidos?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Datos válidos?": {
      "main": [
        [
          {
            "node": "Enviar correo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder error 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar correo": {
      "main": [
        [
          {
            "node": "Responder OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
